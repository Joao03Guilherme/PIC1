\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Balanced accuracy (\%\,mean $\pm $ std.) on MNIST. For the classical classifiers (RBF-C and CNM-C) the encoding is not applicable, so we leave it empty. For the quantum-inspired classifiers (QNM-C) we show the results for the three encodings described in Sec.~\ref {par:encodings}. The Fidelity distance is being calculated using the JTC, as described in Sec.~\ref {subsec:qic}. The best results for each encoding are in \textbf  {bold}.\relax }}{7}{table.caption.23}\protected@file@percent }
\newlabel{tab:cls-results}{{1}{7}{Balanced accuracy (\%\,mean $\pm $ std.) on MNIST. For the classical classifiers (RBF-C and CNM-C) the encoding is not applicable, so we leave it empty. For the quantum-inspired classifiers (QNM-C) we show the results for the three encodings described in Sec.~\ref {par:encodings}. The Fidelity distance is being calculated using the JTC, as described in Sec.~\ref {subsec:qic}. The best results for each encoding are in \textbf {bold}.\relax }{table.caption.23}{}}
